{
  "name": "pdf-desensitization-new",
  "productName": "PDF Desensitization",
  "branding": {
    "name": "Redactera",
    "nameZh": "页隐"
  },
  "installIdentity": {
    "macBundleId": "com.electron.pdf-desensitization",
    "squirrelName": "pdf_desensitization_new"
  },
  "version": "2.0.1",
  "description": "PDF 文档脱敏工具",
  "main": ".webpack/main/index.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:backend": "node scripts/build-backend.cjs",
    "package": "node scripts/build-app.cjs package",
    "make": "node scripts/build-app.cjs make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "set-version": "node scripts/set-version.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage && npm run test:coverage:verify",
    "test:coverage:verify": "node scripts/verify-coverage.cjs",
    "test:e2e:setup": "node e2e/fixtures/generate-test-pdfs.js",
    "test:e2e": "node scripts/run-e2e.cjs",
    "test:e2e:packaged": "node scripts/run-packaged-e2e.cjs",
    "test:storage:native": "node scripts/verify-native-storage.cjs",
    "check:mac-signing": "node scripts/check-mac-signing.cjs",
    "check:mac-release": "node scripts/verify-mac-release.cjs",
    "test:e2e:readiness": "node scripts/run-e2e.cjs --suite readiness",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.e2e.json --noEmit && tsc --project tsconfig.build.json --noEmit",
    "test:e2e:native-dialogs": "node scripts/run-packaged-e2e.cjs --suite native-dialogs",
    "check:windows-release": "node scripts/verify-windows-release.cjs",
    "icons:generate": "node scripts/generate-icons.cjs",
    "icons:check": "node scripts/check-icons.cjs",
    "icons:verify": "node scripts/generate-icons.cjs --check"
  },
  "keywords": [],
  "author": "jonann",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaterGauge/redactera.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "css-loader": "^6.11.0",
    "electron": "45.3.3",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "extract-zip": "2.0.1",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "^28.1.0",
    "node-loader": "^2.1.0",
    "patch-package": "^8.0.1",
    "pdfkit": "^0.17.2",
    "proxy-agent": "8.0.1",
    "style-loader": "^3.3.4",
    "tar": "7.5.22",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "wdio-electron-service": "^9.2.1",
    "webdriverio": "^9.24.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "electron-squirrel-startup": "^1.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.5"
    },
    "mocha": {
      "serialize-javascript": "7.1.4"
    },
    "sockjs": {
      "uuid": "11.1.1"
    },
    "wdio-electron-service": {
      "puppeteer-core": "25.16.0"
    }
  }
}
