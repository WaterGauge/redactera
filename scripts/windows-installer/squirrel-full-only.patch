+        static void writeFullPackage(DirectoryInfo source, string archivePath)
+        {
+            var root = source.FullName.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            using (var archive = ZipFile.Open(archivePath, ZipArchiveMode.Create, Encoding.UTF8)) {
+                foreach (var item in source.EnumerateFileSystemInfos("*", SearchOption.AllDirectories)) {
+                    // .NET Framework 4.5's CreateFromDirectory writes backslashes on Windows.
+                    var entryName = item.FullName.Substring(root.Length + 1).Replace(Path.DirectorySeparatorChar, '/');
+                    var directory = item as DirectoryInfo;
+                    if (directory == null) {
+                        archive.CreateEntryFromFile(item.FullName, entryName, CompressionLevel.Optimal);
+                    } else if (!directory.EnumerateFileSystemInfos().Any()) {
+                        archive.CreateEntry(entryName + "/").LastWriteTime = directory.LastWriteTime;
+                    }
+                }
+            }
+        }
