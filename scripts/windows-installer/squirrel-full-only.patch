+            var prefix = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) +
+                Path.DirectorySeparatorChar;
+            var destination = Path.GetFullPath(Path.Combine(prefix, Path.Combine(parts)));
