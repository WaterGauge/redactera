+            RegexOptions.CultureInvariant | RegexOptions.IgnoreCase);
+
+        static string[] entryParts(ZipArchiveEntry entry, bool directory)
+        {
+            var name = entry.FullName.Replace('\\', '/');
+            return (directory ? name.Substring(0, name.Length - 1) : name).Split('/');
+        }
+
+        static bool isDirectory(ZipArchiveEntry entry)
+        {
+            return entry.FullName.EndsWith("/", StringComparison.Ordinal) ||
+                   entry.FullName.EndsWith("\\", StringComparison.Ordinal);
+        }
+
+        static string pathUnderRoot(string root, string[] parts)
+        {
+            foreach (var part in parts) {
+                if (String.IsNullOrEmpty(part) || part.EndsWith(".", StringComparison.Ordinal) ||
+                    part.EndsWith(" ", StringComparison.Ordinal) ||
+                    part.IndexOfAny(InvalidEntryCharacters) >= 0 || ReservedDeviceName.IsMatch(part)) {
+                    throw new InvalidDataException("Package entry has an invalid Windows path.");
+                }
+            }
